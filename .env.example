# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Application / client ID from the same page
CLIENT_ID=your_application_id

# Default prefix for text commands (can be overridden per guild with !setprefix)
PREFIX=!

# Optional: restrict slash-command registration to these guild IDs (comma-separated).
# Leave empty to register globally.
SLASH_GUILD_IDS=

# ── Database ─────────────────────────────────────────────────────────────
# Path to the SQLite database file
DB_PATH=./data/brainzbot.db

# ── Encryption ───────────────────────────────────────────────────────────
# 64-hex-char (32 byte) master key used to encrypt ListenBrainz user tokens.
# If omitted, a random key is generated once and stored in ./data/.enc_key
# (permissions 0600). Prefer a real key in production:
#   openssl rand -hex 32
BRAINZBOT_ENC_KEY=

# ── ListenBrainz ─────────────────────────────────────────────────────────
# API base (leave default unless you run a proxy)
LISTENBRAINZ_BASE_URL=https://api.listenbrainz.org

# ── Logging ──────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
