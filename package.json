{
  "name": "riff-relay-bot",
  "version": "1.0.0",
  "private": true,
  "description": "RiffRelay is an unofficial Discord music-history companion for ListenBrainz, with slash and prefix commands and encrypted user tokens.",
  "type": "module",
  "license": "MPL-2.0",
  "bin": {
    "riff-relay": "dist/bot.js"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --env-file=.env --watch src/index.ts",
    "start": "bun --env-file=.env dist/bot.js",
    "build": "bun scripts/compiler.ts",
    "build:dev": "BOT_BUILD_DEV=1 bun scripts/compiler.ts",
    "register": "bun --env-file=.env src/scripts/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src test scripts",
    "lint:fix": "biome check --write src test scripts",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts"
  },
  "dependencies": {
    "listenbrainz-api": "0.3.0",
    "discord.js": "^14.28.1",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "listenbrainz-api"
  ]
}
